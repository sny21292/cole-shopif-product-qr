# Server
PORT=3000
NODE_ENV=development

# Shopify
SHOPIFY_STORE_DOMAIN=turn-offroad.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpca_xxxxx
SHOPIFY_API_VERSION=2026-04

# Metafield
METAFIELD_NAMESPACE=custom
METAFIELD_VIDEO_KEY=install_video_url

# Fallback URL (QR for variants without a video)
FALLBACK_URL=https://turnoffroad.com/contact

# Cache TTL in seconds (how long to cache Shopify lookups)
CACHE_TTL=3600
